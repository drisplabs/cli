{
	"$schema": "https://unpkg.com/knip@5/schema.json",
	"workspaces": {
		".": {
			"entry": [
				"src/app/entry/cli.tsx",
				"src/harnesses/claude/hook-forwarder.ts",
				"scripts/theme-preview.ts",
				"scripts/perf-runner.mjs"
			],
			"project": [
				"src/**/*.{ts,tsx}",
				"!src/**/*.test.ts",
				"!src/**/*.test.tsx",
				"!src/**/__tests__/**",
				"!src/**/__sentinels__/**",
				"scripts/**/*.{ts,mjs}"
			]
		},
		"packages/protocol": {
			"entry": ["src/index.ts", "scripts/*.ts"],
			"project": ["src/**/*.ts", "scripts/**/*.ts", "!src/**/*.test.ts"]
		}
	},
	"ignore": ["dist/**", "packages/*/dist/**"]
}
