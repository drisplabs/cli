{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://raw.githubusercontent.com/drisplabs/cli/main/packages/protocol/schema/runtime-decision.json",
	"title": "runtime-decision",
	"x-protocol-version": 1,
	"type": "object",
	"properties": {
		"type": {
			"type": "string",
			"enum": ["passthrough", "block", "json"]
		},
		"source": {
			"type": "string",
			"enum": ["user", "timeout", "rule"]
		},
		"intent": {
			"oneOf": [
				{
					"type": "object",
					"properties": {
						"kind": {
							"type": "string",
							"const": "permission_allow"
						}
					},
					"required": ["kind"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"type": "string",
							"const": "permission_deny"
						},
						"reason": {
							"type": "string"
						}
					},
					"required": ["kind", "reason"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"type": "string",
							"const": "question_answer"
						},
						"answers": {
							"type": "object",
							"propertyNames": {
								"type": "string"
							},
							"additionalProperties": {
								"type": "string"
							}
						}
					},
					"required": ["kind", "answers"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"type": "string",
							"const": "pre_tool_allow"
						}
					},
					"required": ["kind"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"type": "string",
							"const": "pre_tool_deny"
						},
						"reason": {
							"type": "string"
						}
					},
					"required": ["kind", "reason"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"type": "string",
							"const": "stop_block"
						},
						"reason": {
							"type": "string"
						}
					},
					"required": ["kind", "reason"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"type": "string",
							"const": "compact_block"
						},
						"reason": {
							"type": "string"
						}
					},
					"required": ["kind", "reason"],
					"additionalProperties": false
				}
			]
		},
		"reason": {
			"type": "string"
		},
		"data": {}
	},
	"required": ["type", "source"],
	"additionalProperties": false
}
